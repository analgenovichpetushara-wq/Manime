# Copy to .env (never commit .env) — AnimAlc reads these at build time.
# Watch Together synchronization server (WebSocket). Leave empty to disable the feature.
EXPO_PUBLIC_WATCH_TOGETHER_URL=ws://localhost:8787
# Optional provider endpoint overrides (defaults are the public, documented endpoints).
EXPO_PUBLIC_ANILIBRIA_BASE_URL=https://api.anilibria.app/api/v1
EXPO_PUBLIC_ANIME365_BASE_URL=https://smotret-anime.online/api
EXPO_PUBLIC_SHIKIMORI_BASE_URL=https://shikimori.io/api
EXPO_PUBLIC_ENV=production
